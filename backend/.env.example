# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

PORT=5000

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.XXXXX.mongodb.net/bedspace-bills?retryWrites=true&w=majority

# JWT secret — use any long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Gmail SMTP — use an App Password (not your real Gmail password)
# How to get: Google Account → Security → 2-Step Verification → App passwords
EMAIL_USER=bedspaceph@gmail.com
EMAIL_PASS=rqnq qdzi fooq jjbs
EMAIL_FROM="Bedspace Bill Manager <bedspaceph@gmail.com>"

# Cloudinary — get from https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Your deployed frontend URL (update after Vercel deploy)
FRONTEND_URL=https://your-app.vercel.app
